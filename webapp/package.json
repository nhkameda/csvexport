{
  "name": "csvexport-webapp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "tsx test/validate.ts",
    "build": "tsc && cd frontend && npm run build"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "concurrently": "^8.2.2",
    "@types/node": "^20.14.0"
  }
}
